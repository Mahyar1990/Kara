{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kara:clasor:pa04:output:1.0.0",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "role_id": {
      "const": "PA-04"
    },
    "request_sha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "ready_for_review",
        "needs_clarification",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "scope": {
      "type": "object",
      "properties": {
        "included": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "minItems": 0,
          "maxItems": 12
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "minItems": 0,
          "maxItems": 12
        }
      },
      "required": [
        "included",
        "excluded"
      ],
      "additionalProperties": false
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^C-[a-zA-Z0-9_-]+$"
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^(request|S-[a-zA-Z0-9_-]+)$"
            },
            "minItems": 1,
            "maxItems": 30,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "quote",
          "source_refs"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 30
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^R-[a-zA-Z0-9_-]+$"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "condition_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^C-[a-zA-Z0-9_-]+$"
            },
            "minItems": 1,
            "maxItems": 30,
            "uniqueItems": true
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^(request|S-[a-zA-Z0-9_-]+)$"
            },
            "minItems": 1,
            "maxItems": 30,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "statement",
          "condition_ids",
          "source_refs"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 30
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^AC-[a-zA-Z0-9_-]+$"
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^R-[a-zA-Z0-9_-]+$"
            },
            "minItems": 1,
            "maxItems": 30,
            "uniqueItems": true
          },
          "given": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "when": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "then": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^(request|S-[a-zA-Z0-9_-]+)$"
            },
            "minItems": 1,
            "maxItems": 30,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "requirement_ids",
          "given",
          "when",
          "then",
          "source_refs"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 30
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^Q-[a-zA-Z0-9_-]+$"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "blocking": {
            "type": "boolean"
          },
          "condition_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^C-[a-zA-Z0-9_-]+$"
            },
            "minItems": 0,
            "maxItems": 30,
            "uniqueItems": true
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^(request|S-[a-zA-Z0-9_-]+)$"
            },
            "minItems": 1,
            "maxItems": 30,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "question",
          "reason",
          "blocking",
          "condition_ids",
          "source_refs"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 12
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^A-[a-zA-Z0-9_-]+$"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "needs_confirmation": {
            "const": true
          }
        },
        "required": [
          "id",
          "statement",
          "needs_confirmation"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 12
    }
  },
  "required": [
    "contract_version",
    "role_id",
    "request_sha256",
    "status",
    "summary",
    "scope",
    "conditions",
    "requirements",
    "acceptance_criteria",
    "questions",
    "assumptions"
  ],
  "additionalProperties": false
}
