{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kara:clasor:pa04:input:1.0.0",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "role_id": {
      "const": "PA-04"
    },
    "binding": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "request_revision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "stage_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "base_revision": {
          "type": "integer",
          "minimum": 1
        },
        "request_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_bundle_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "previous_analysis_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "previous_artifact_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "project_id",
        "request_id",
        "request_revision_id",
        "stage_id",
        "base_revision",
        "previous_analysis_sha256",
        "request_sha256",
        "source_bundle_sha256",
        "previous_artifact_id"
      ],
      "additionalProperties": false
    },
    "mode": {
      "enum": [
        "analyze",
        "clarify",
        "review_change"
      ]
    },
    "request": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "text",
        "sha256"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^S-[a-zA-Z0-9_-]+$"
          },
          "kind": {
            "enum": [
              "repository_rule",
              "evidence"
            ]
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "kind",
          "reference",
          "revision",
          "content",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 4
    },
    "feedback_context": {
      "type": "string",
      "maxLength": 8000
    },
    "previous_analysis": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 16000
    }
  },
  "required": [
    "contract_version",
    "role_id",
    "binding",
    "mode",
    "request",
    "sources",
    "feedback_context",
    "previous_analysis"
  ],
  "additionalProperties": false
}
