# Optional overrides for the local launcher; credentials belong in Dify settings.
DIFY_HTTP_PORT=8080
DIFY_HTTPS_PORT=8443
DIFY_PROJECT_NAME=company-agent-local

# Network access is opt-in. Use the same public origin in every browser.
DIFY_BIND_ADDRESS=127.0.0.1
DIFY_PUBLIC_URL=
# Example for a server: bind 0.0.0.0 and set https://kara.example.internal

# Optional organization-specific build inputs; no credentials in these URLs.
KARA_NPM_REGISTRY=https://registry.npmjs.org/
KARA_CA_BUNDLE=
KARA_BOOTSTRAP_IMAGE=python:3.12-bookworm
KARA_TOOLS_IMAGE=python:3.12-bookworm
DIFY_WEAVIATE_IMAGE=cr.weaviate.io/semitechnologies/weaviate:1.39.2
